#!/usr/bin/env bash
# Block a push that would land the reference index and the usage playbook out of
# sync. Tracked in the repo and activated by install.sh (`core.hooksPath`), so a
# fresh clone gets the enforcement, not just the rule — and it fires for terminal
# pushes and agent pushes alike, since git runs it either way.
#
# What gets checked is the COMMITS BEING PUSHED, not the working tree. git feeds
# one `<local ref> <local sha> <remote ref> <remote sha>` line per ref on stdin,
# and each local sha is checked at that revision. That means a half-finished doc
# edit sitting in the working tree can't block an unrelated branch's push, and
# pushing an explicit refspec while checked out elsewhere examines the refspec
# rather than whatever happens to be checked out.
#
# Bypass with `git push --no-verify` when you genuinely mean to.
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
CHECK="$REPO/scripts/check-doc-sync.py"

[ -f "$CHECK" ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found — cannot run the doc sync check." >&2
  echo "          Install python3, or push with --no-verify if you accept the risk." >&2
  exit 1
fi

status=0
saw_ref=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  saw_ref=1

  # An all-zero local sha means the ref is being deleted — there is no tree to
  # check, and a delete must not be held up by whatever is in the working tree.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  python3 "$CHECK" --rev "$local_sha" || status=1
done

# No ref lines at all means git isn't driving us — a hand-run of the hook, say.
# Fall back to the working tree so an invocation like that still reports
# something. A push that only deletes refs has ref lines, so it lands above.
if [ "$saw_ref" -eq 0 ]; then
  python3 "$CHECK" || status=1
fi

exit "$status"
